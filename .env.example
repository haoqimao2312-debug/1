# AI Provider: mock | deepseek | openai | anthropic
AI_PROVIDER=mock

# 日后接真 LLM 时填入对应 Key
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Supabase backend
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local server storage for uploaded user files.
# Defaults to G:\xinyu on Windows if omitted.
# SERVER_STORAGE_DRIVER=auto # auto | supabase | local
# SERVER_STORAGE_ROOT=G:\xinyu

# Admin backend
# Development default password is "matchu-admin" when ADMIN_PASSWORD is empty.
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
